    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.108.4",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.79.0",
    "maplibre-gl": "^5.24.1",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "sonner": "2.0.8",
    "three": "^0.186.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
