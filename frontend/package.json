{
  "name": "arterial-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Arterial web app: real-time traffic intelligence on Condense (Configure 2026). Prepared before the build window, disclosed in docs/COMPLIANCE.md.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
