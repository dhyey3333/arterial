# Copy to .env and fill in. Never commit .env.
# Values marked (window) are created during the build window, 28-29 Nov 2026 IST.

# --- Frontend (Vite reads VITE_* at build time) ---
# Base URL of the Arterial API. Empty = same origin.
VITE_API_URL=http://localhost:8000
# live = REST + SSE from the API. fixtures = dev-only design fixtures (never for the demo).
VITE_DATA_SOURCE=live

# --- Kafka on the Condense-managed cluster (window) ---
# Team prefix confirmed by the organizers with your login, e.g. byte-runners
TEAM_PREFIX=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=

# --- Simulator (window) ---
SIM_SEED=2026
SIM_VEHICLES=400
SIM_EVENTS_PER_SECOND=200
SIM_SCENARIO=normal

# --- API service (window) ---
DATABASE_URL=sqlite:///./arterial.db
API_CORS_ORIGINS=http://localhost:5173
